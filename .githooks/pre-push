#!/usr/bin/env bash
# Run repository validation before pushing if any plugin, marketplace, or local
# skill files changed. Version checks use the actual remote/local ref pair, so a
# behavior change cannot leave both plugin cache keys unchanged.
#
# Enable via: git config core.hooksPath .githooks
# (Done once per clone; the hook lives in-repo so it's discoverable.)

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

# --- privacy gate (fail-closed, runs on EVERY push) ---------------------------
# A real ID/path/key can live in any file, committed at any time — so scan the
# whole tracked tree on every push, not just when plugin files change. Fails
# CLOSED: a missing runtime or an incomplete scan refuses the push rather than
# letting it through silently.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found — cannot run the privacy scan; refusing to push (fail-closed)." >&2
  echo "pre-push: install node, or bypass with --no-verify only if you are certain." >&2
  exit 1
fi
if ! node "$repo_root/scripts/privacy-scan"; then
  echo "" >&2
  echo "pre-push: privacy scan failed — real IDs/paths/keys must not reach this public repo." >&2
  echo "pre-push: replace findings above with generic placeholders, then re-push." >&2
  echo "pre-push: bypass with --no-verify only if you know what you're doing." >&2
  exit 1
fi

# Read refs being pushed from stdin.
# Format per line: <local-ref> <local-sha> <remote-ref> <remote-sha>
# If remote-sha is all zeros, the remote ref doesn't exist yet.
zero="0000000000000000000000000000000000000000"
touched_relevant=0
ranges=()

while read -r local_ref local_sha remote_ref remote_sha; do
  # Ref names are useful context when this hook is debugged, even though the
  # validation range itself is SHA-based.
  : "$local_ref" "$remote_ref"
  if [ -z "$local_sha" ] || [ "$local_sha" = "$zero" ]; then
    # Empty line or branch deletion — nothing to validate.
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    # New branch — diff against main if it exists, else skip.
    base=$(git rev-parse --verify --quiet main 2>/dev/null || echo "")
  else
    base="$remote_sha"
  fi
  if [ -z "$base" ]; then
    files=$(git -C "$repo_root" diff-tree --no-commit-id --name-only -r "$local_sha")
  else
    files=$(git -C "$repo_root" diff --name-only "$base" "$local_sha")
  fi
  if echo "$files" | grep -qE '^(plugins/|\.claude-plugin/|\.agents/plugins/|\.agents/skills/|\.claude/skills/)'; then
    touched_relevant=1
    if [ -n "$base" ]; then
      ranges+=("$base:$local_sha")
    fi
  fi
done

if [ "$touched_relevant" -eq 0 ]; then
  exit 0
fi

echo "pre-push: validating manifests..." >&2
if ! bash "$repo_root/scripts/validate-manifests.sh"; then
  echo "" >&2
  echo "pre-push: validation failed — fix the errors above and re-push." >&2
  echo "pre-push: bypass with --no-verify only if you know what you're doing." >&2
  exit 1
fi

for range in "${ranges[@]}"; do
  base=${range%%:*}
  target=${range#*:}
  echo "pre-push: checking plugin version bumps ($base..$target)..." >&2
  if ! bash "$repo_root/scripts/validate-manifests.sh" --base "$base" --target "$target"; then
    echo "" >&2
    echo "pre-push: a plugin behavior change requires a version bump in both manifests." >&2
    echo "pre-push: fix the errors above and re-push." >&2
    exit 1
  fi
done
