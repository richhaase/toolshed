#!/usr/bin/env node
'use strict';
//
// eval-score — deterministic golden-query scorer for a Memento.
//
// The mechanical gate primitive of the control plane (no LLM judge). Node, not
// bash/python/ruby, because node is guaranteed wherever this runs: the Claude
// Code and Codex harnesses (CLI + desktop) ARE node, and JSON is native — zero
// deps, zero parse code. Given the committed fixtures under sources/eval/ and
// the COMPILED artifacts (AGENTS.md hot set + optional wiki answer-surface
// pages), it checks
// per fixture:
//   - every required_evidence_path exists
//   - every required_answer_atom is present in the compiled answer surface
// and emits the frozen verdict contract. Abstain fixtures and the
// forbidden_paths(private/) touch-check are runtime-behavioral — out of scope
// for the static gate; they belong to the on-demand LLM-answering eval.
//
// Used by:  memento:compile (Gate-0, between hot-set rewrite and commit) and
//           memento:health-check (eval mode). Lives in _shared so neither skill
//           reaches into the other's directory.
//
// Exit:  0 = pass or advisory   1 = FAIL (regression regressed)   2 = error
//   compile rolls back on exit >= 1 (fail-closed: a scorer it cannot run is not
//   a clean bill of health).
//
// Usage:
//   eval-score [--root DIR] [--suite regression|capability|all] [--json] [--quiet]
//   eval-score --self-test     # prove the scorer FAILS a poisoned hot set

const fs = require('fs');
const path = require('path');
const cp = require('child_process');
const os = require('os');

const argv = process.argv.slice(2);
const opt = { root: process.env.MEMENTO_ROOT || process.cwd(), json: false, quiet: false, suite: 'all', selfTest: false, gate: false, noLog: false };
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--root') opt.root = argv[++i];
  else if (a === '--json') opt.json = true;
  else if (a === '--quiet') opt.quiet = true;
  else if (a === '--suite') opt.suite = argv[++i];
  else if (a === '--self-test') opt.selfTest = true;
  else if (a === '--gate') opt.gate = true;          // compile passes this: emit a defect follow-up on fail
  else if (a === '--no-log') opt.noLog = true;        // skip the runs-ledger append
  else if (a === '-h' || a === '--help') {
    console.error('usage: eval-score [--root DIR] [--suite regression|capability|all] [--json] [--quiet] [--gate] [--no-log] [--self-test]');
    process.exit(0);
  }
}
const today = () => new Date().toISOString().slice(0, 10);

function die(msg) { console.error('eval-score: ' + msg); process.exit(2); }
function slurp(p) { try { return fs.readFileSync(p, 'utf8'); } catch { return ''; } }
function arrayOfStrings(v) { return Array.isArray(v) ? v.filter(x => typeof x === 'string' && x) : []; }

function stripRediscoveryRegion(text) {
  const starts = [...text.matchAll(/<!-- REDISCOVERY START\b/g)].map(m => m.index);
  const ends = [...text.matchAll(/<!-- REDISCOVERY END\b/g)].map(m => m.index);
  if (starts.length === 0 && ends.length === 0) return { text, status: 'absent' };
  if (starts.length !== 1 || ends.length !== 1 || ends[0] < starts[0]) return { text, status: 'malformed' };
  const endClose = text.indexOf('-->', ends[0]);
  if (endClose < 0) return { text, status: 'malformed' };
  return { text: text.slice(0, starts[0]) + text.slice(endClose + 3), status: 'balanced' };
}

function answerSurfacePaths(fx) {
  const explicit = [
    ...arrayOfStrings(fx.answer_surface_paths),
    ...arrayOfStrings(fx.compiled_evidence_paths),
  ];
  if (explicit.length) return explicit;

  // Back-compat: older fixtures only had required_evidence_paths. Treat wiki
  // paths there as compiled evidence, but never let source paths satisfy the
  // answer atom. Sources prove provenance; compiled surfaces prove retrieval.
  return arrayOfStrings(fx.required_evidence_paths).filter(p =>
    p === 'AGENTS.md' || p === 'CLAUDE.md' || p.startsWith('wiki/')
  );
}

function isCompiledSurfacePath(p) {
  return p === 'AGENTS.md' || p === 'CLAUDE.md' || p.startsWith('wiki/');
}

// Score one fixture against the haystack. Returns {pass, reason, skip}.
function scoreFixture(fx, root) {
  if (fx.abstain_required) return { pass: true, reason: 'skipped: abstain (runtime-only, not gated)', skip: true };

  const evidence = arrayOfStrings(fx.required_evidence_paths);
  const missingPaths = evidence.filter(p => !fs.existsSync(path.join(root, p)));
  if (missingPaths.length) return { pass: false, reason: `missing evidence path(s): ${missingPaths.join(', ')}`, skip: false };

  const surfacePaths = answerSurfacePaths(fx);
  const nonCompiledSurfacePaths = surfacePaths.filter(p => !isCompiledSurfacePath(p));
  if (nonCompiledSurfacePaths.length) return { pass: false, reason: `answer surface path(s) are not compiled surfaces: ${nonCompiledSurfacePaths.join(', ')}`, skip: false };
  const missingSurfacePaths = surfacePaths.filter(p => !fs.existsSync(path.join(root, p)));
  if (missingSurfacePaths.length) return { pass: false, reason: `missing answer surface path(s): ${missingSurfacePaths.join(', ')}`, skip: false };

  // Haystack = the always-resident hot set + explicitly named compiled
  // answer-surface pages. Source evidence paths are deliberately excluded so a
  // stale compile cannot pass just because the raw source still has the fact.
  let hay = stripRediscoveryRegion(slurp(path.join(root, 'AGENTS.md'))).text;
  for (const p of surfacePaths) {
    if (p !== 'AGENTS.md') hay += '\n' + slurp(path.join(root, p));
  }
  const hayLC = hay.toLowerCase();

  // The static gate verifies REQUIRED atoms are present (case-insensitive) — i.e. the
  // load-bearing fact survived the compile. It does NOT enforce forbidden_answer_atoms
  // or abstain: those are ANSWER-LEVEL, verifiable only by actually answering the
  // question (the on-demand LLM eval). A corpus substring scan false-positives on them —
  // the hot set mentions every entity, and pages describe history/fixes using old values
  // (e.g. "Former role: Solutions Engineer", "text-embedding-3-small -> -large").
  const req = arrayOfStrings(fx.required_answer_atoms);
  if (req.length === 0) return { pass: false, reason: 'fixture has no required_answer_atoms', skip: false };
  const missingAtoms = req.filter(a => !hayLC.includes(String(a).toLowerCase()));
  if (missingAtoms.length) return { pass: false, reason: `required atom(s) absent: ${missingAtoms.map(x => JSON.stringify(x)).join(', ')}`, skip: false };
  return { pass: true, reason: 'ok', skip: false };
}

function loadSuite(root, name) {
  const p = path.join(root, 'sources', 'eval', 'fixtures', name + '.json');
  if (!fs.existsSync(p)) return [];
  try {
    const d = JSON.parse(fs.readFileSync(p, 'utf8'));
    return Array.isArray(d) ? d.filter(x => x && x.id) : [];
  } catch (e) { die(`could not parse ${p}: ${e.message}`); }
}

function thresholds(root) {
  let reg = 1.0, cap = 0.8;
  const p = path.join(root, 'sources', 'eval', 'verdict-contract.json');
  if (fs.existsSync(p)) {
    let doc;
    try {
      doc = JSON.parse(fs.readFileSync(p, 'utf8'));
    } catch (e) {
      die(`could not parse ${p}: ${e.message}`);
    }
    const t = doc.thresholds || {};
    if (t.regression_pass_rate_min != null) reg = thresholdValue(t.regression_pass_rate_min, 'regression_pass_rate_min', p);
    if (t.capability_pass_rate_min != null) cap = thresholdValue(t.capability_pass_rate_min, 'capability_pass_rate_min', p);
  }
  return { reg, cap };
}

function thresholdValue(raw, key, file) {
  const parsed = parseThreshold(raw, key, file);
  if (!parsed.ok) die(parsed.reason);
  return parsed.value;
}

function parseThreshold(raw, key, file) {
  const n = Number(raw);
  if (!Number.isFinite(n) || n < 0 || n > 1) {
    return { ok: false, reason: `${file} threshold ${key} must be a finite number between 0 and 1` };
  }
  return { ok: true, value: n };
}

function headSha(root) {
  try { return cp.execFileSync('git', ['-C', root, 'rev-parse', 'HEAD'], { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); }
  catch { return ''; }
}

// --- self-test: prove the scorer FAILS a deliberately poisoned hot set -------
if (opt.selfTest) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'eval-self-'));
  fs.mkdirSync(path.join(dir, 'wiki'), { recursive: true });
  fs.mkdirSync(path.join(dir, 'sources', 'notes'), { recursive: true });
  fs.writeFileSync(path.join(dir, 'AGENTS.md'), 'clean hot set\n');
  fs.writeFileSync(path.join(dir, 'wiki', 'probe.md'), 'marker-present\n');
  fs.writeFileSync(path.join(dir, 'sources', 'notes', 'probe.md'), 'source-only-marker\n');
  const fx = { id: 'ST1', required_evidence_paths: ['wiki/probe.md'], required_answer_atoms: ['marker-present'], forbidden_answer_atoms: ['poison-token'], abstain_required: false };
  const clean = scoreFixture(fx, dir);
  fs.writeFileSync(path.join(dir, 'wiki', 'probe.md'), 'the marker was dropped; poison-token injected\n');
  const poisoned = scoreFixture(fx, dir);
  const sourceOnly = scoreFixture({
    id: 'ST2',
    required_evidence_paths: ['sources/notes/probe.md'],
    required_answer_atoms: ['source-only-marker'],
  }, dir);
  const contractDir = fs.mkdtempSync(path.join(os.tmpdir(), 'eval-contract-self-'));
  fs.mkdirSync(path.join(contractDir, 'sources', 'eval'), { recursive: true });
  fs.writeFileSync(path.join(contractDir, 'sources', 'eval', 'verdict-contract.json'), JSON.stringify({ thresholds: { regression_pass_rate_min: 0.5, capability_pass_rate_min: '0.25' } }));
  const validContract = thresholds(contractDir);
  const invalidContractFailed = !parseThreshold('not-a-number', 'regression_pass_rate_min', path.join(contractDir, 'sources', 'eval', 'verdict-contract.json')).ok;
  const malformedContractDir = fs.mkdtempSync(path.join(os.tmpdir(), 'eval-contract-bad-self-'));
  fs.mkdirSync(path.join(malformedContractDir, 'sources', 'eval'), { recursive: true });
  fs.writeFileSync(path.join(malformedContractDir, 'AGENTS.md'), 'hot set\n');
  fs.writeFileSync(path.join(malformedContractDir, 'sources', 'eval', 'verdict-contract.json'), '{ not json');
  const malformed = cp.spawnSync(process.execPath, [__filename, '--root', malformedContractDir, '--json', '--no-log'], { encoding: 'utf8' });
  const malformedContractFailed = malformed.status === 2 && String(malformed.stderr || '').includes('could not parse');
  fs.writeFileSync(path.join(dir, 'AGENTS.md'), 'clean hot set\n<!-- REDISCOVERY START -->\nrediscovery-only-atom\n<!-- REDISCOVERY END -->\n');
  const rdExcised = !scoreFixture({ id: 'RD1', required_evidence_paths: ['AGENTS.md'], answer_surface_paths: ['AGENTS.md'], required_answer_atoms: ['rediscovery-only-atom'] }, dir).pass;
  const rdControl = scoreFixture({ id: 'RD2', required_evidence_paths: ['AGENTS.md'], answer_surface_paths: ['AGENTS.md'], required_answer_atoms: ['clean hot set'] }, dir).pass;
  fs.writeFileSync(path.join(dir, 'AGENTS.md'), 'clean hot set\n<!-- REDISCOVERY START -->\norphan marker\n');
  const rdMalformed = stripRediscoveryRegion(slurp(path.join(dir, 'AGENTS.md'))).status === 'malformed';
  try { fs.rmSync(dir, { recursive: true, force: true }); } catch { /* best effort */ }
  try { fs.rmSync(contractDir, { recursive: true, force: true }); } catch { /* best effort */ }
  try { fs.rmSync(malformedContractDir, { recursive: true, force: true }); } catch { /* best effort */ }
  if (!opt.quiet) {
    console.error(`self-test: clean=${clean.pass ? 'PASS' : 'FAIL'} poisoned=${poisoned.pass ? 'PASS(!)' : 'FAIL(correct)'}`);
    console.error('self-test: poisoned reason -> ' + poisoned.reason);
    console.error(`self-test: source-only evidence=${sourceOnly.pass ? 'PASS(!)' : 'FAIL(correct)'}`);
    console.error(`self-test: verdict-contract=${validContract.reg === 0.5 && validContract.cap === 0.25 && invalidContractFailed && malformedContractFailed ? 'PASS' : 'FAIL'}`);
    console.error(`self-test: rediscovery-region excised=${rdExcised ? 'PASS' : 'FAIL(!)'} control-atom=${rdControl ? 'PASS' : 'FAIL(!)'} malformed-detected=${rdMalformed ? 'PASS' : 'FAIL(!)'}`);
  }
  if (clean.pass && !poisoned.pass && !sourceOnly.pass && validContract.reg === 0.5 && validContract.cap === 0.25 && invalidContractFailed && malformedContractFailed && rdExcised && rdControl && rdMalformed) {
    if (!opt.quiet) console.error('self-test: OK — scorer correctly fails a poisoned hot set and ignores the rediscovery region.');
    process.exit(0);
  }
  console.error('self-test: BROKEN — scorer did not catch a poisoned hot set. Refusing to certify.');
  process.exit(2);
}

// --- normal scoring ----------------------------------------------------------
const root = path.resolve(opt.root);
if (!fs.existsSync(path.join(root, 'AGENTS.md'))) die(`not a Memento root (no AGENTS.md at ${root})`);
if (stripRediscoveryRegion(slurp(path.join(root, 'AGENTS.md'))).status === 'malformed') die('unbalanced <!-- REDISCOVERY --> markers in AGENTS.md hot set — refusing to certify');

const suites = opt.suite === 'regression' ? ['regression'] : opt.suite === 'capability' ? ['capability'] : ['regression', 'capability'];
const { reg: regMin, cap: capMin } = thresholds(root);
const t0 = Date.now();
const results = {};
const sliceFails = [];
let totalScored = 0;

for (const suite of suites) {
  const fixtures = loadSuite(root, suite);
  let passed = 0, scored = 0, skipped = 0;
  for (const fx of fixtures) {
    const r = scoreFixture(fx, root);
    if (r.skip) { skipped++; continue; }
    scored++;
    if (r.pass) passed++;
    else sliceFails.push({ fixture_id: fx.id, suite, reason: r.reason });
  }
  totalScored += scored;
  const rate = scored === 0 ? 1.0 : +(passed / scored).toFixed(4);
  results[suite] = { pass: passed, scored, skipped, pass_rate: rate };
}

const regRate = results.regression ? results.regression.pass_rate : 1.0;
const capRate = results.capability ? results.capability.pass_rate : 1.0;
const regressionScored = results.regression ? results.regression.scored : 0;
const elapsed = +((Date.now() - t0) / 1000).toFixed(3);
const verdict = regressionScored === 0 ? 'ungated' : (regRate < regMin ? 'fail' : (capRate < capMin ? 'advisory' : 'pass'));

const out = {
  tier: process.env.MEMENTO_EVAL_TIER || 'local',
  regression_pass_rate: regRate,
  capability_pass_rate: capRate,
  suites: results,
  slice_fails: sliceFails,
  cost: { tokens: 0, seconds: elapsed },
  kappa: null,
  verdict,
  gated: verdict !== 'ungated',
  total_scored: totalScored,
  scored_at_sha: headSha(root),
  thresholds: { regression_pass_rate_min: regMin, capability_pass_rate_min: capMin }
};

// Telemetry: the scorer owns its own record (compile's no-sources-write rule stays
// intact). JSONL under sources/eval/runs/ — doctor-invisible (not .md), git-committable.
if (!opt.noLog) {
  try {
    const runsDir = path.join(root, 'sources', 'eval', 'runs');
    fs.mkdirSync(runsDir, { recursive: true });
    fs.appendFileSync(path.join(runsDir, today() + '.jsonl'), JSON.stringify(out) + '\n');
  } catch (e) { console.error('eval-score: warning — could not write runs ledger: ' + e.message); }
}

// Gate mode: on a regression FAIL, emit a defect follow-up so the loop closes
// (telemetry -> source). Only with --gate (compile passes it; health-check eval does not).
if (opt.gate && verdict === 'fail') {
  try {
    const fdir = path.join(root, 'sources', 'followups');
    fs.mkdirSync(fdir, { recursive: true });
    const exp = new Date(Date.now() + 7 * 864e5).toISOString().slice(0, 10);
    const fails = sliceFails.map(f => `- [${f.suite}] ${f.fixture_id}: ${f.reason}`).join('\n');
    const md = `---\ndate: ${today()}\nexpires_at: ${exp}\nkind: eval-defect\nrationale: Compile gate failed; reread within a week to repair the dropped regression fact or update the stale fixture.\n---\n\n` +
      `# Compile eval gate FAILED — ${today()}\n\n` +
      `The in-compile eval gate (Gate-0) failed: a regression fixture's load-bearing fact ` +
      `was missing from the freshly-compiled hot set + wiki, so the compile was rolled back ` +
      `(\`git checkout COMPILE_BASE_SHA -- AGENTS.md wiki/\`) and NOT committed.\n\n` +
      `Failing fixtures:\n${fails}\n\n` +
      `Act: either the compile dropped a fact (re-run / fix compile) or the fixture is stale ` +
      `(update sources/eval/fixtures/). Full verdict in sources/eval/runs/${today()}.jsonl.\n`;
    fs.writeFileSync(path.join(fdir, `compile-eval-fail-${today()}.md`), md);
  } catch (e) { console.error('eval-score: warning — could not emit defect follow-up: ' + e.message); }
}

if (opt.json) {
  process.stdout.write(JSON.stringify(out, null, 2) + '\n');
} else if (!opt.quiet) {
  console.error(`Memento eval — ${root}`);
  for (const [s, r] of Object.entries(results)) {
    console.error(`  ${s.padEnd(11)} ${r.pass}/${r.scored} pass (${Math.round(r.pass_rate * 100)}%)${r.skipped ? ` · ${r.skipped} skipped (abstain)` : ''}`);
  }
  if (verdict === 'ungated') console.error('  warning: no scored regression fixtures; compile is not gated');
  if (sliceFails.length) {
    console.error('  failures:');
    for (const f of sliceFails) console.error(`    [${f.suite}] ${f.fixture_id}: ${f.reason}`);
  }
  console.error(`  verdict: ${verdict.toUpperCase()}  (${elapsed}s, mechanical · 0 tokens)`);
}

process.exit(verdict === 'fail' ? 1 : 0);
