#!/usr/bin/env bash
# shellcheck disable=SC2088 # Literal ~/ inputs are the behavior under test and expansion target.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: memento-root [--allow-missing]
       memento-root --self-test

Print the configured Memento root.

Resolution order:
  1. MEMENTO_ROOT environment variable
  2. nearest .memento-root file walking upward from the current directory
  3. current directory, if it already looks like a Memento

.memento-root may contain an absolute path, a ~ path, or a path relative to
the directory containing the marker file. Blank lines and # comments are
ignored.
EOF
}

allow_missing=false
if [[ ( "${1:-}" == "--help" || "${1:-}" == "-h" ) && $# -eq 1 ]]; then
  usage
  exit 0
elif [[ "${1:-}" == "--self-test" && $# -eq 1 ]]; then
  self_test=true
elif [[ "${1:-}" == "--allow-missing" && $# -eq 1 ]]; then
  allow_missing=true
elif [[ $# -gt 0 ]]; then
  usage >&2
  exit 64
fi

expand_path() {
  local raw="$1"
  local base="${2:-}"

  case "$raw" in
    "~") raw="$HOME" ;;
    "~/"*) raw="$HOME/${raw#\~/}" ;;
  esac

  if [[ "$raw" = /* ]]; then
    printf '%s\n' "$raw"
  elif [[ -n "$base" ]]; then
    printf '%s/%s\n' "$base" "$raw"
  else
    printf '%s/%s\n' "$(pwd)" "$raw"
  fi
}

self_test() {
  local script tmp home out rc
  script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/memento-root-test.XXXXXX")"
  trap 'rm -rf "$tmp"' RETURN
  tmp="$(cd "$tmp" && pwd -P)"
  home="$tmp/home"

  mkdir -p "$home/tilde-root" \
    "$tmp/env-root" "$tmp/env-work" \
    "$tmp/marker-absolute/nested" "$tmp/marker-relative/nested" \
    "$tmp/marker-tilde/nested" "$tmp/relative-root" \
    "$tmp/cwd-memento/sources" "$tmp/cwd-memento/wiki" \
    "$tmp/unconfigured" "$tmp/empty-marker"
  : > "$tmp/cwd-memento/AGENTS.md"

  # Environment value wins over a nearby marker.
  printf '%s\n' "$tmp/relative-root" > "$tmp/env-work/.memento-root"
  out="$(cd "$tmp/env-work" && HOME="$home" MEMENTO_ROOT="$tmp/env-root" "$script")"
  [[ "$out" == "$tmp/env-root" ]] || { printf 'self-test: env precedence failed: %s\n' "$out" >&2; return 1; }

  # Relative environment paths resolve from the caller's current directory.
  out="$(cd "$tmp" && HOME="$home" MEMENTO_ROOT="env-root" "$script")"
  [[ "$out" == "$tmp/env-root" ]] || { printf 'self-test: relative env failed: %s\n' "$out" >&2; return 1; }

  # Tilde environment paths expand against HOME, without retaining a literal '~'.
  out="$(cd "$tmp" && HOME="$home" MEMENTO_ROOT='~/tilde-root' "$script")"
  [[ "$out" == "$home/tilde-root" ]] || { printf 'self-test: tilde env failed: %s\n' "$out" >&2; return 1; }

  printf '%s\n' "$tmp/env-root" > "$tmp/marker-absolute/.memento-root"
  out="$(cd "$tmp/marker-absolute/nested" && unset MEMENTO_ROOT; HOME="$home" "$script")"
  [[ "$out" == "$tmp/env-root" ]] || { printf 'self-test: absolute marker failed: %s\n' "$out" >&2; return 1; }

  printf '%s\n' '../relative-root' > "$tmp/marker-relative/.memento-root"
  out="$(cd "$tmp/marker-relative/nested" && unset MEMENTO_ROOT; HOME="$home" "$script")"
  [[ "$out" == "$tmp/relative-root" ]] || { printf 'self-test: relative marker failed: %s\n' "$out" >&2; return 1; }

  printf '%s\n' '~/tilde-root' > "$tmp/marker-tilde/.memento-root"
  out="$(cd "$tmp/marker-tilde/nested" && unset MEMENTO_ROOT; HOME="$home" "$script")"
  [[ "$out" == "$home/tilde-root" ]] || { printf 'self-test: tilde marker failed: %s\n' "$out" >&2; return 1; }

  out="$(cd "$tmp/cwd-memento" && unset MEMENTO_ROOT; HOME="$home" "$script")"
  [[ "$out" == "$tmp/cwd-memento" ]] || { printf 'self-test: cwd fallback failed: %s\n' "$out" >&2; return 1; }

  out="$(cd "$tmp" && HOME="$home" MEMENTO_ROOT="$tmp/missing-root" "$script" --allow-missing)"
  [[ "$out" == "$tmp/missing-root" ]] || { printf 'self-test: allow-missing failed: %s\n' "$out" >&2; return 1; }

  set +e
  (cd "$tmp" && HOME="$home" MEMENTO_ROOT="$tmp/missing-root" "$script" >/dev/null 2>&1)
  rc=$?
  set -e
  [[ $rc -eq 66 ]] || { printf 'self-test: missing-root exit was %s, expected 66\n' "$rc" >&2; return 1; }

  set +e
  (cd "$tmp/unconfigured" && unset MEMENTO_ROOT; HOME="$home" "$script" >/dev/null 2>&1)
  rc=$?
  set -e
  [[ $rc -eq 69 ]] || { printf 'self-test: unconfigured exit was %s, expected 69\n' "$rc" >&2; return 1; }

  : > "$tmp/empty-marker/.memento-root"
  set +e
  (cd "$tmp/empty-marker" && unset MEMENTO_ROOT; HOME="$home" "$script" >/dev/null 2>&1)
  rc=$?
  set -e
  [[ $rc -eq 65 ]] || { printf 'self-test: empty-marker exit was %s, expected 65\n' "$rc" >&2; return 1; }

  printf 'self-test: OK\n'
}

canonicalize_existing() {
  local path="$1"
  (cd "$path" 2>/dev/null && pwd -P)
}

canonicalize_maybe_missing() {
  local path="$1"
  local parent
  parent="$(dirname "$path")"
  local leaf
  leaf="$(basename "$path")"
  (cd "$parent" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$leaf")
}

print_root() {
  local candidate="$1"
  if [[ -d "$candidate" ]]; then
    canonicalize_existing "$candidate"
    exit 0
  fi

  if [[ "$allow_missing" == true ]]; then
    if ! canonicalize_maybe_missing "$candidate"; then
      printf 'memento-root: parent directory for configured Memento root does not exist: %s\n' "$candidate" >&2
      exit 66
    fi
    exit 0
  fi

  printf 'memento-root: configured Memento root does not exist: %s\n' "$candidate" >&2
  exit 66
}

find_marker_root() {
  local marker_name="$1"
  local dir marker target
  dir="$(pwd -P)"

  while true; do
    marker="$dir/$marker_name"
    if [[ -f "$marker" ]]; then
      target="$(sed -n '/^[[:space:]]*#/d; /^[[:space:]]*$/d; s/^[[:space:]]*//; s/[[:space:]]*$//; p; q' "$marker")"
      if [[ -z "$target" ]]; then
        printf 'memento-root: %s exists but contains no path\n' "$marker" >&2
        exit 65
      fi
      print_root "$(expand_path "$target" "$dir")"
    fi

    if [[ "$dir" == "/" ]]; then
      break
    fi
    dir="$(dirname "$dir")"
  done
}

if [[ "${self_test:-false}" == true ]]; then
  self_test
  exit $?
fi

if [[ -n "${MEMENTO_ROOT:-}" ]]; then
  print_root "$(expand_path "$MEMENTO_ROOT")"
fi

find_marker_root ".memento-root"

cwd="$(pwd -P)"
if [[ -d "$cwd/sources" && -d "$cwd/wiki" && -f "$cwd/AGENTS.md" ]]; then
  printf '%s\n' "$cwd"
  exit 0
fi

cat >&2 <<'EOF'
memento-root: no Memento root configured.

Set MEMENTO_ROOT, add a .memento-root file containing the Memento path, or run
memento-config in a directory that should become the Memento root.
EOF
exit 69
