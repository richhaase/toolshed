#!/usr/bin/env bash
set -eu

usage() {
  cat <<'USAGE'
Usage: roll [--count N] [--grid PATH]

Sample N unique domain prompts from the Ostrich tangent grid. The prompts widen
the candidate pool; they do not choose the tangent. Set OSTRICH_SEED to make a
roll reproducible.
USAGE
}

script_dir=$(cd "$(dirname "$0")" && pwd)
grid="$script_dir/../references/tangent-grid.md"
count=5

while [ $# -gt 0 ]; do
  case "$1" in
    --count)
      [ $# -ge 2 ] || { echo "roll: --count requires a number" >&2; exit 2; }
      count=$2
      shift 2
      ;;
    --grid)
      [ $# -ge 2 ] || { echo "roll: --grid requires a path" >&2; exit 2; }
      grid=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "roll: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$count" in
  ''|*[!0-9]*) echo "roll: --count must be a positive integer" >&2; exit 2 ;;
esac
[ "$count" -ge 1 ] || { echo "roll: --count must be a positive integer" >&2; exit 2; }
[ -f "$grid" ] || { echo "roll: grid not found: $grid" >&2; exit 2; }

domains=$(awk '
  /^## / { active = ($0 == "## Domains"); next }
  active && /^- / { sub(/^- /, ""); print }
' "$grid")
domain_count=$(printf '%s\n' "$domains" | grep -c . || true)
[ "$domain_count" -gt 0 ] || { echo "roll: grid has no entries under '## Domains'" >&2; exit 3; }
[ "$count" -le "$domain_count" ] || {
  echo "roll: --count cannot exceed the $domain_count available domains" >&2
  exit 2
}

if [ -n "${OSTRICH_SEED:-}" ]; then
  state=$(( OSTRICH_SEED & 0x7fffffff ))
else
  state=$(( ( (RANDOM << 16) ^ ($$ << 4) ^ $(date +%s) ) & 0x7fffffff ))
fi

rand() {
  state=$(( (state * 1103515245 + 12345) & 0x7fffffff ))
  r=$(( (state >> 8) % $1 ))
}

selected=''
i=1
while [ "$i" -le "$count" ]; do
  rand "$domain_count"
  picked=$(printf '%s\n' "$domains" | sed -n "$(( r + 1 ))p")
  if printf '%s\n' "$selected" | grep -Fxq -- "$picked"; then
    continue
  fi
  selected="${selected}${selected:+
}${picked}"
  printf 'candidate %d: %s\n' "$i" "$picked"
  i=$(( i + 1 ))
done
